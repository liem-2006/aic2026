#!/bin/sh
set -eu
if [ -x code/local_retrieval/venv/Scripts/python.exe ]; then
  exec code/local_retrieval/venv/Scripts/python.exe tools/check_secrets.py --staged
elif [ -x code/local_retrieval/venv/bin/python ]; then
  exec code/local_retrieval/venv/bin/python tools/check_secrets.py --staged
fi
echo 'Create code/local_retrieval/venv before committing; secret checks are required.' >&2
exit 1
